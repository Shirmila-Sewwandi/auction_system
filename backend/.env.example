# Port 5433, not 5432 — this machine already runs a local Postgres Windows service on 5432.
DATABASE_URL=postgresql+psycopg://auction:auction@localhost:5433/auction_db
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fallback defaults used only if platform_config has no row yet (Phase 10 seeds one)
DEFAULT_MIN_BID_INCREMENT=1.00
DEFAULT_ANTI_SNIPING_WINDOW_MINUTES=5
DEFAULT_ANTI_SNIPING_EXTENSION_MINUTES=10

# Optional (spec §4.1) — current_price read-through cache only. The app works fine with no
# Redis running: cache calls fail soft and fall straight through to PostgreSQL.
REDIS_URL=redis://localhost:6379/0
